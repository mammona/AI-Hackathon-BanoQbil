APP_ENV=development
DATABASE_URL=sqlite:///./fasal_guard.db
DATA_DIR=data/reports
AUTO_SEED_DEMO_DEVICES=true
DEMO_DEVICES_FILE=data/demo_devices.json

SIGLIP_MODEL=google/siglip-base-patch16-224
SIGLIP_DEVICE=cpu
CROP_MIN_CONFIDENCE=0.45
CROP_MIN_MARGIN=0.08

COTTON_MODEL_PATH=models/disease/cotton_disease_classifier.pt
RICE_MODEL_PATH=models/disease/rice_disease_classifier.pt
DISEASE_CLASS_MAPPINGS_PATH=models/disease/class_mappings.json
DISEASE_THRESHOLD=0.70
DISEASE_MIN_MARGIN=0.10
ALLOW_MISSING_DISEASE_MODEL=true

# Geo-temporal outbreak linking radius.
OUTBREAK_RADIUS_KM=5.0
# Farmer alert delivery radius from the calculated outbreak center.
NOTIFICATION_RADIUS_KM=2.0
OUTBREAK_TIME_WINDOW_DAYS=7

# Local generative model. Q1 only copies verbatim symptom spans; Q2-Q4 normalize fields.
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen3:1.7b
QWEN_TIMEOUT_SECONDS=120
QWEN_ALLOW_FALLBACK=true

# V11 language-selected multilingual symptom RAG.
# Default has no API fee: local Ollama qwen3-embedding:0.6b.
SYMPTOM_EMBEDDING_BACKEND=ollama
SYMPTOM_EMBEDDING_MODEL=qwen3-embedding:0.6b
SYMPTOM_EMBEDDING_DEVICE=cpu
SYMPTOM_EMBEDDING_TIMEOUT_SECONDS=120
# SYMPTOM_RAG_IDENTITY_WEIGHT is deprecated and ignored in V11.

# Starter thresholds. Tune from the 10-case/expanded benchmark before freezing.
SYMPTOM_MATCH_THRESHOLD=0.55
SYMPTOM_MIN_MARGIN=0.05

CORS_ORIGINS=*

# V17 retrieve -> dedicated Qwen3 reranker
SYMPTOM_RAG_TOP_K=5
SYMPTOM_RETRIEVAL_FLOOR=0.45
SYMPTOM_DIRECT_ACCEPT_THRESHOLD=0.65
SYMPTOM_DIRECT_ACCEPT_MARGIN=0.08
SYMPTOM_RERANK_ENABLED=true
SYMPTOM_RERANK_TOP_K=3
SYMPTOM_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
SYMPTOM_RERANKER_DEVICE=auto
SYMPTOM_RERANKER_MAX_LENGTH=512
SYMPTOM_RERANKER_MIN_SCORE=0.50
SYMPTOM_RERANKER_MIN_MARGIN=0.00
SYMPTOM_RERANKER_LOCAL_FILES_ONLY=false
